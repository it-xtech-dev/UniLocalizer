<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <Authors>xtech.dev@gmail.com</Authors>
    <Company>xtech.pl</Company>
    <Copyright>xtech.pl</Copyright>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Description>ASP.NET Core JSON/SQL localization with optional translator UI. See README for integration scenarios.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <AssemblyVersion>1.1.2</AssemblyVersion>
    <FileVersion>1.1.2</FileVersion>
    <Version>2.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <PropertyGroup>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <PackageReleaseNotes>.NET 6.0 compatible version. Cross platform ready</PackageReleaseNotes>
    <Title>Unilocalizer</Title>
    <PackageProjectUrl>https://github.com/it-xtech-dev/UniLocalizer</PackageProjectUrl>
    <RepositoryUrl>https://github.com/it-xtech-dev/UniLocalizer</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>localization, i18n, translation, languages</PackageTags>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.15" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="NUglify" Version="1.23.7" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="wwwroot\**\*" />
  </ItemGroup>

